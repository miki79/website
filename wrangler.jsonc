{
  // Static site on Cloudflare Workers. src/worker.js runs first to redirect
  // alias domains (giardi.net) to miki.me.uk; everything else is ./public.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miki-me-uk",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "miki.me.uk", "custom_domain": true },
    { "pattern": "www.miki.me.uk", "custom_domain": true },
    // Alias domains: redirected to miki.me.uk by src/worker.js
    { "pattern": "giardi.net", "custom_domain": true },
    { "pattern": "www.giardi.net", "custom_domain": true }
  ]
}
