{
  // Static site on Cloudflare Workers: static assets only, no Worker code, so
  // requests don't count against the Workers daily request limit. The redirects
  // (www.miki.me.uk and giardi.net to https://miki.me.uk) are Cloudflare
  // Redirect Rules on each zone, which run before the Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miki-me-uk",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "miki.me.uk", "custom_domain": true },
    { "pattern": "www.miki.me.uk", "custom_domain": true },
    // www and the alias domains are redirected to miki.me.uk by Redirect Rules;
    // the custom domains are kept so Cloudflare keeps their DNS records.
    { "pattern": "giardi.net", "custom_domain": true },
    { "pattern": "www.giardi.net", "custom_domain": true }
  ]
}
